# Copy to .env and fill in. Never commit .env.
# Easiest: run scripts/generate-key.sh, which creates .env and saves a new
# key into it without printing it. Keys expire (roughly daily); re-run it.
# Manual alternative: https://codechallenge.essensedesigns.info/api-key
EOA_API_KEY=
EOA_API_BASE_URL=https://codechallenge.essensedesigns.info

# Optional overrides (defaults shown; fine for local use)
# DB_NAME=gamevoting
# DB_USER=gamevoting
# DB_PASSWORD=gamevoting
# APP_DEBUG=0

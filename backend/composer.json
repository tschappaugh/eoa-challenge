{
  "name": "eoa/game-voting-api",
  "description": "Backend for the Essense of Australia game voting challenge",
  "type": "project",
  "require": {
    "php": ">=8.3",
    "ext-pdo": "*",
    "guzzlehttp/guzzle": "^7.9",
    "slim/psr7": "^1.7",
    "slim/slim": "^4.14"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit"
  }
}
